rules_version = '2';

// Firebase Storage Security Rules for CareerVerse
service firebase.storage {
  match /b/{bucket}/o {
    
    // Avatar uploads - users can upload/update their own avatar
    // Anyone authenticated can read avatars (for profile display)
    match /avatars/{userId}/{fileName} {
      // Allow authenticated users to read any avatar (to view profiles)
      allow read: if request.auth != null;
      
      // Allow users to create/update/delete only their own avatar
      allow write: if request.auth != null 
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024  // Max 5MB
                   && request.resource.contentType.matches('image/.*');  // Only images
    }
    
    // Deny all other access by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
