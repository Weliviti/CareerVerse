# Environment Variables for CareerVerse Backend
# Copy this file to .env and fill in your actual values

# ─── Gemini API Keys (3 separate keys for cost tracking & isolation) ───
# Legacy single key — used as fallback if specific keys are not set
GEMINI_API_KEY=your_gemini_api_key_here

# Key for AI student/patient agent conversations during simulations
GEMINI_KEY_PERSONAS=your_personas_api_key_here

# Key for real-time scoring and final session evaluation
GEMINI_KEY_SCORING=your_scoring_api_key_here

# Key for career recommendation generation and personalized advice
GEMINI_KEY_CAREERS=your_careers_api_key_here

# ─── Firebase ───
# Firebase Service Account Path (relative to backend directory)
FIREBASE_SERVICE_ACCOUNT_PATH=service-account.json

# ─── App Settings ───
# Environment (development/production)
ENVIRONMENT=development
