# ─── Gemini API Keys (rotated automatically on 429 quota errors) ───
GEMINI_KEY_1=
GEMINI_KEY_2=
GEMINI_KEY_3=
GEMINI_KEY_4=

# ─── Firebase ───
# Option 1: JSON string (for cloud hosting like Render)
# Paste entire contents of service-account.json here
FIREBASE_CREDENTIALS_JSON=

# Option 2: File path (for local development)
FIREBASE_CREDENTIALS_PATH=../firebase/service-account.json

# ─── CORS (comma-separated extra allowed origins) ───
CORS_ORIGINS=

# ─── App Settings ───
ENVIRONMENT=development

# ─── SMTP (for 2FA email OTP) ───
SMTP_EMAIL=
SMTP_APP_PASSWORD=
